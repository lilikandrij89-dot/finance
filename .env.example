# Необов'язково для локального тестування (без цих ключів додаток працює через вбудований серверний Realtime/SSE).
# Обов'язково для хмарного деплою на Vercel (для синхронізації між 25 телефонами через Supabase Realtime).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Пароль для входу в пульт викладача /admin (за замовчуванням 3434)
NEXT_PUBLIC_ADMIN_PIN=3434
